# AES Nexus Environment Configuration
PORT=3000
NODE_ENV=development

# Selector de servidor de base de datos: auto | neon | docker | local
DB_PROVIDER=auto

# Neon PostgreSQL (nube, TLS requerido por defecto)
DATABASE_URL=

# Docker PostgreSQL (contenedor local o servidor Docker del cliente, TLS desactivado por defecto)
# Formato: postgresql://USUARIO:PASSWORD@HOST:5432/BASE_DE_DATOS
DOCKER_DATABASE_URL=

# Alternativa por parámetros discretos (aplica si no usas DATABASE_URL / DOCKER_DATABASE_URL)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Opcional: require | disable | verify-full (vacío = automático según proveedor)
PGSSLMODE=

# Seguridad y Auth
CORS_ORIGIN=
JWT_SECRET=
JWT_ISSUER=aes-nexus-api
JWT_AUDIENCE=aes-nexus-app
JWT_EXPIRES_IN_SECONDS=28800
OIDC_JWKS_URI=
OIDC_ISSUER=
OIDC_AUDIENCE=
ADMIN_BOOTSTRAP_PASSCODE=
