// ============================================================================
// AES Nexus · Prisma Schema (PostgreSQL 16+ · Neon & Docker PostgreSQL)
// Multi-tenancy (organization_id) + Identificador Externo universal (external_id)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. EMPRESAS, ORGANIZACIONES, ESTRUCTURA Y USUARIOS
// ============================================================================

model Organization {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String    @unique @db.VarChar(80)
  name              String    @db.VarChar(160)
  status            String    @default("active") @db.VarChar(20)
  planTier          String    @default("Enterprise") @map("plan_tier") @db.VarChar(24)
  reportingCurrency String    @default("MXN") @map("reporting_currency") @db.VarChar(8)
  externalId        String?   @map("external_id") @db.VarChar(120)
  externalSource    String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt  DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships          OrganizationMembership[]
  subsidiaries         Subsidiary[]
  departments          Department[]
  locations            Location[]
  clients              Client[]
  suppliers            Supplier[]
  employees            Employee[]
  payrollRuns          PayrollRun[]
  catalogItems         CatalogItem[]
  quotes               Quote[]
  salesOrders          SalesOrder[]
  salesInvoices        SalesInvoice[]
  customerReturns      CustomerReturn[]
  warehouses           Warehouse[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]
  inventoryTransfers   InventoryTransfer[]
  shipments            Shipment[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  purchaseReceptions   PurchaseReception[]
  supplierReturns      SupplierReturn[]
  externalMappings     ExternalIdMapping[]

  @@index([externalSource, externalId])
  @@map("core_organizations")
}

model Subsidiary {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  code                String    @db.VarChar(30)
  legalName           String    @map("legal_name") @db.VarChar(200)
  tradeName           String    @map("trade_name") @db.VarChar(160)
  taxId               String    @map("tax_id") @db.VarChar(24)
  country             String    @db.VarChar(80)
  currency            String    @default("MXN") @db.VarChar(8)
  status              String    @default("Activa") @db.VarChar(20)
  isHeadquarters      Boolean   @default(false) @map("is_headquarters")
  linkedDepartmentIds String[]  @default([]) @map("linked_department_ids") @db.Uuid
  linkedLocationIds   String[]  @default([]) @map("linked_location_ids") @db.Uuid
  externalId          String?   @map("external_id") @db.VarChar(120)
  externalSource      String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt    DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departments  Department[]
  locations    Location[]
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, externalSource, externalId])
  @@map("admin_subsidiaries")
}

model Department {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(140)
  costCenter       String    @map("cost_center") @db.VarChar(40)
  leader           String    @db.VarChar(150)
  subsidiaryId     String?   @map("subsidiary_id") @db.Uuid
  locationId       String?   @map("location_id") @db.Uuid
  status           String    @default("Activo") @db.VarChar(20)
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subsidiary           Subsidiary?           @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  employees            Employee[]
  purchaseRequisitions PurchaseRequisition[]

  @@unique([organizationId, code])
  @@index([organizationId, externalSource, externalId])
  @@map("admin_departments")
}

model Location {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(140)
  type             String    @db.VarChar(40)
  city             String    @db.VarChar(100)
  state            String    @db.VarChar(100)
  address          String    @db.VarChar(250)
  subsidiaryId     String?   @map("subsidiary_id") @db.Uuid
  status           String    @default("Activa") @db.VarChar(20)
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subsidiary   Subsidiary?  @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  employees    Employee[]
  warehouses   Warehouse[]

  @@unique([organizationId, code])
  @@index([organizationId, externalSource, externalId])
  @@map("admin_locations")
}

model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oidcSubject      String    @unique @map("oidc_subject") @db.VarChar(180)
  email            String    @unique @db.VarChar(180)
  fullName         String    @map("full_name") @db.VarChar(160)
  avatarInitials   String    @map("avatar_initials") @db.VarChar(4)
  passwordHash     String?   @map("password_hash")
  status           String    @default("active") @db.VarChar(20)
  mfaEnrolled      Boolean   @default(false) @map("mfa_enrolled")
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships OrganizationMembership[]
  employees   Employee[]

  @@index([externalSource, externalId])
  @@map("core_users")
}

model OrganizationMembership {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  status           String    @default("active") @db.VarChar(20)
  primaryRoleId    String    @map("primary_role_id") @db.VarChar(80)
  roleIds          String[]  @default([]) @map("role_ids")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, externalSource, externalId])
  @@map("core_organization_memberships")
}

// ============================================================================
// 2. EMPLEADOS Y NÓMINA
// ============================================================================

model Employee {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  employeeCode       String    @map("employee_code") @db.VarChar(30)
  fullName           String    @map("full_name") @db.VarChar(160)
  email              String    @db.VarChar(180)
  phone              String?   @db.VarChar(40)
  position           String    @db.VarChar(120)
  departmentId       String?   @map("department_id") @db.Uuid
  locationId         String?   @map("location_id") @db.Uuid
  subsidiaryId       String?   @map("subsidiary_id") @db.Uuid
  status             String    @default("Activo") @db.VarChar(24)
  contractType       String    @map("contract_type") @db.VarChar(40)
  paymentFrequency   String    @map("payment_frequency") @db.VarChar(24)
  grossMonthlySalary Decimal   @map("gross_monthly_salary") @db.Decimal(18, 2)
  rfc                String?   @db.VarChar(24)
  curp               String?   @db.VarChar(24)
  nss                String?   @db.VarChar(20)
  bankPackValues     Json?     @map("bank_pack_values")
  userId             String?   @map("user_id") @db.Uuid
  externalId         String?   @map("external_id") @db.VarChar(120)
  externalSource     String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt   DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  subsidiary   Subsidiary?  @relation(fields: [subsidiaryId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, employeeCode])
  @@index([organizationId, externalSource, externalId])
  @@map("crm_employees")
}

model PayrollRun {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  periodLabel      String    @map("period_label") @db.VarChar(120)
  frequency        String    @db.VarChar(24)
  paymentDate      DateTime  @map("payment_date") @db.Date
  status           String    @default("Borrador") @db.VarChar(24)
  totalGross       Decimal   @map("total_gross") @db.Decimal(18, 2)
  totalDeductions  Decimal   @map("total_deductions") @db.Decimal(18, 2)
  totalNet         Decimal   @map("total_net") @db.Decimal(18, 2)
  receipts         Json      @default("[]")
  bankAccountId    String?   @map("bank_account_id") @db.Uuid
  expensePolicyId  String?   @map("expense_policy_id") @db.Uuid
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("crm_payroll_runs")
}

// ============================================================================
// 3. PRODUCTOS Y CATÁLOGO
// ============================================================================

model CatalogItem {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  sku              String    @db.VarChar(64)
  name             String    @db.VarChar(200)
  itemType         String    @map("item_type") @db.VarChar(20)
  category         String    @db.VarChar(80)
  unit             String    @default("Pieza") @db.VarChar(32)
  unitPrice        Decimal   @map("unit_price") @db.Decimal(18, 4)
  costPrice        Decimal   @default(0) @map("cost_price") @db.Decimal(18, 4)
  taxRate          Decimal   @default(16) @map("tax_rate") @db.Decimal(7, 4)
  currency         String    @default("MXN") @db.VarChar(8)
  billingModel     String    @default("Único") @map("billing_model") @db.VarChar(24)
  status           String    @default("Activo") @db.VarChar(20)
  trackInventory   Boolean   @default(true) @map("track_inventory")
  description      String?
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, externalSource, externalId])
  @@map("sal_catalog_items")
}

// ============================================================================
// 4. VENTAS (CLIENTES, COTIZACIONES, PEDIDOS, FACTURAS Y DEVOLUCIONES)
// ============================================================================

model Client {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  clientCode       String?   @map("client_code") @db.VarChar(40)
  entityType       String    @default("company") @map("entity_type") @db.VarChar(20)
  company          String    @db.VarChar(180)
  name             String    @db.VarChar(150)
  email            String    @db.VarChar(180)
  phone            String    @default("") @db.VarChar(40)
  rfc              String?   @db.VarChar(24)
  status           String    @default("Activo") @db.VarChar(20)
  country          String?   @default("MX") @db.VarChar(8)
  currency         String    @default("MXN") @db.VarChar(8)
  paymentTerms     String    @default("Contado") @map("payment_terms") @db.VarChar(40)
  city             String?   @db.VarChar(120)
  state            String?   @db.VarChar(120)
  notes            String?
  addresses        Json      @default("[]")
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quotes          Quote[]
  salesOrders     SalesOrder[]
  salesInvoices   SalesInvoice[]
  customerReturns CustomerReturn[]

  @@index([organizationId, externalSource, externalId])
  @@map("crm_clients")
}

model Quote {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  clientId         String?   @map("client_id") @db.Uuid
  clientName       String    @map("client_name") @db.VarChar(180)
  issueDate        DateTime  @map("issue_date") @db.Date
  validUntil       DateTime  @map("valid_until") @db.Date
  status           String    @default("Borrador") @db.VarChar(24)
  currency         String    @default("MXN") @db.VarChar(8)
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  subtotal         Decimal   @db.Decimal(18, 2)
  taxAmount        Decimal   @map("tax_amount") @db.Decimal(18, 2)
  total            Decimal   @db.Decimal(18, 2)
  items            Json      @default("[]")
  notes            String?
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  orders       SalesOrder[]

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("sal_quotes")
}

model SalesOrder {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  quoteId          String?   @map("quote_id") @db.Uuid
  clientId         String?   @map("client_id") @db.Uuid
  clientName       String    @map("client_name") @db.VarChar(180)
  orderDate        DateTime  @map("order_date") @db.Date
  deliveryDate     DateTime? @map("delivery_date") @db.Date
  status           String    @default("Confirmado") @db.VarChar(24)
  currency         String    @default("MXN") @db.VarChar(8)
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  subtotal         Decimal   @db.Decimal(18, 2)
  taxAmount        Decimal   @map("tax_amount") @db.Decimal(18, 2)
  total            Decimal   @db.Decimal(18, 2)
  items            Json      @default("[]")
  notes            String?
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quote           Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoices        SalesInvoice[]
  customerReturns CustomerReturn[]
  shipments       Shipment[]

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("sal_orders")
}

model SalesInvoice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  orderId          String?   @map("order_id") @db.Uuid
  clientId         String?   @map("client_id") @db.Uuid
  clientName       String    @map("client_name") @db.VarChar(180)
  issueDate        DateTime  @map("issue_date") @db.Date
  dueDate          DateTime  @map("due_date") @db.Date
  status           String    @default("Emitida") @db.VarChar(24)
  billingMode      String    @default("Fiscal") @map("billing_mode") @db.VarChar(24)
  cfdiUuid         String?   @map("cfdi_uuid") @db.VarChar(36)
  currency         String    @default("MXN") @db.VarChar(8)
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  subtotal         Decimal   @db.Decimal(18, 2)
  taxAmount        Decimal   @map("tax_amount") @db.Decimal(18, 2)
  total            Decimal   @db.Decimal(18, 2)
  items            Json      @default("[]")
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order           SalesOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  customerReturns CustomerReturn[]

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("sal_invoices")
}

model CustomerReturn {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  orderId          String?   @map("order_id") @db.Uuid
  invoiceId        String?   @map("invoice_id") @db.Uuid
  clientId         String?   @map("client_id") @db.Uuid
  clientName       String    @map("client_name") @db.VarChar(180)
  reason           String    @db.VarChar(80)
  resolution       String    @db.VarChar(60)
  status           String    @default("Solicitada") @db.VarChar(32)
  currency         String    @default("MXN") @db.VarChar(8)
  totalRefund      Decimal   @default(0) @map("total_refund") @db.Decimal(18, 2)
  items            Json      @default("[]")
  workflowHistory  Json      @default("[]") @map("workflow_history")
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        SalesOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice      SalesInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("sal_customer_returns")
}

// ============================================================================
// 5. COMPRAS (PROVEEDORES, REQUISICIONES, ÓRDENES, RECEPCIONES Y DEVOLUCIONES)
// ============================================================================

model Supplier {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  vendorCode       String?   @map("vendor_code") @db.VarChar(40)
  entityType       String    @default("company") @map("entity_type") @db.VarChar(20)
  company          String    @db.VarChar(180)
  name             String    @db.VarChar(150)
  email            String    @db.VarChar(180)
  phone            String    @default("") @db.VarChar(40)
  rfc              String?   @db.VarChar(24)
  category         String?   @db.VarChar(80)
  status           String    @default("Activo") @db.VarChar(20)
  country          String?   @default("MX") @db.VarChar(8)
  currency         String    @default("MXN") @db.VarChar(8)
  paymentTerms     String    @default("Crédito 30 días") @map("payment_terms") @db.VarChar(40)
  addresses        Json      @default("[]")
  notes            String?
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrders  PurchaseOrder[]
  supplierReturns SupplierReturn[]

  @@index([organizationId, externalSource, externalId])
  @@map("crm_suppliers")
}

model PurchaseRequisition {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  requesterName    String    @map("requester_name") @db.VarChar(150)
  departmentId     String?   @map("department_id") @db.Uuid
  priority         String    @default("Media") @db.VarChar(20)
  status           String    @default("Pendiente") @db.VarChar(24)
  neededBy         DateTime? @map("needed_by") @db.Date
  items            Json      @default("[]")
  notes            String?
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("pur_requisitions")
}

model PurchaseOrder {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  requisitionId    String?   @map("requisition_id") @db.Uuid
  supplierId       String?   @map("supplier_id") @db.Uuid
  supplierName     String    @map("supplier_name") @db.VarChar(180)
  warehouseId      String?   @map("warehouse_id") @db.Uuid
  orderDate        DateTime  @map("order_date") @db.Date
  expectedDate     DateTime? @map("expected_date") @db.Date
  status           String    @default("Emitida") @db.VarChar(24)
  currency         String    @default("MXN") @db.VarChar(8)
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  subtotal         Decimal   @db.Decimal(18, 2)
  taxAmount        Decimal   @map("tax_amount") @db.Decimal(18, 2)
  total            Decimal   @db.Decimal(18, 2)
  items            Json      @default("[]")
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requisition     PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  supplier        Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse       Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  receptions      PurchaseReception[]
  supplierReturns SupplierReturn[]

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("pur_orders")
}

model PurchaseReception {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  purchaseOrderId  String    @map("purchase_order_id") @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  receivedBy       String    @map("received_by") @db.VarChar(150)
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  lines            Json      @default("[]")
  notes            String?
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("pur_receptions")
}

model SupplierReturn {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  purchaseOrderId  String?   @map("purchase_order_id") @db.Uuid
  supplierId       String?   @map("supplier_id") @db.Uuid
  supplierName     String    @map("supplier_name") @db.VarChar(180)
  reason           String    @db.VarChar(80)
  resolution       String    @db.VarChar(60)
  status           String    @default("Solicitada") @db.VarChar(32)
  currency         String    @default("MXN") @db.VarChar(8)
  totalCredit      Decimal   @default(0) @map("total_credit") @db.Decimal(18, 2)
  items            Json      @default("[]")
  workflowHistory  Json      @default("[]") @map("workflow_history")
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("pur_supplier_returns")
}

// ============================================================================
// 6. INVENTARIO Y OPERACIONES (ALMACENES, STOCK, KARDEX, TRASLADOS Y ENVÍOS)
// ============================================================================

model Warehouse {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(140)
  locationId       String?   @map("location_id") @db.Uuid
  manager          String?   @db.VarChar(150)
  status           String    @default("Activo") @db.VarChar(20)
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location           Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  inventoryItems     InventoryItem[]
  stockMovements     StockMovement[]
  transfersFrom      InventoryTransfer[] @relation("TransferFromWarehouse")
  transfersTo        InventoryTransfer[] @relation("TransferToWarehouse")
  shipments          Shipment[]
  purchaseOrders     PurchaseOrder[]
  purchaseReceptions PurchaseReception[]

  @@unique([organizationId, code])
  @@index([organizationId, externalSource, externalId])
  @@map("ops_warehouses")
}

model InventoryItem {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  sku              String    @db.VarChar(64)
  warehouseId      String    @map("warehouse_id") @db.Uuid
  stockQuantity    Decimal   @default(0) @map("stock_quantity") @db.Decimal(18, 4)
  reservedQuantity Decimal   @default(0) @map("reserved_quantity") @db.Decimal(18, 4)
  minStock         Decimal   @default(0) @map("min_stock") @db.Decimal(18, 4)
  thresholdSource  String    @default("sku") @map("threshold_source") @db.VarChar(20)
  unitCost         Decimal   @default(0) @map("unit_cost") @db.Decimal(18, 4)
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      CatalogItem  @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([organizationId, productId, warehouseId])
  @@index([organizationId, externalSource, externalId])
  @@map("ops_inventory")
}

model StockMovement {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  productId        String    @map("product_id") @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  movementType     String    @map("movement_type") @db.VarChar(24)
  quantity         Decimal   @db.Decimal(18, 4)
  referenceDoc     String?   @map("reference_doc") @db.VarChar(80)
  notes            String?
  actorName        String    @map("actor_name") @db.VarChar(150)
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      CatalogItem  @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("ops_stock_movements")
}

model InventoryTransfer {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  fromWarehouseId  String    @map("from_warehouse_id") @db.Uuid
  toWarehouseId    String    @map("to_warehouse_id") @db.Uuid
  status           String    @default("Solicitado") @db.VarChar(24)
  transferMode     String    @default("Estándar") @map("transfer_mode") @db.VarChar(24)
  items            Json      @default("[]")
  notes            String?
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromWarehouse Warehouse    @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse    @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("ops_transfers")
}

model Shipment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  folio            String    @db.VarChar(30)
  orderId          String?   @map("order_id") @db.Uuid
  warehouseId      String?   @map("warehouse_id") @db.Uuid
  carrier          String    @db.VarChar(120)
  trackingNumber   String?   @map("tracking_number") @db.VarChar(120)
  status           String    @default("Preparando") @db.VarChar(24)
  shippedAt        DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(6)
  externalId       String?   @map("external_id") @db.VarChar(120)
  externalSource   String?   @map("external_source") @db.VarChar(80)
  externalSyncedAt DateTime? @map("external_synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order        SalesOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@unique([organizationId, folio])
  @@index([organizationId, externalSource, externalId])
  @@map("ops_shipments")
}

// ============================================================================
// 7. MAPEO MULTI-SISTEMA DE IDENTIFICADORES EXTERNOS
// ============================================================================

model ExternalIdMapping {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String   @map("entity_id") @db.Uuid
  externalSystem String   @map("external_system") @db.VarChar(80)
  externalId     String   @map("external_id") @db.VarChar(120)
  externalUrl    String?  @map("external_url") @db.VarChar(500)
  syncDirection  String   @default("bidirectional") @map("sync_direction") @db.VarChar(20)
  lastSyncedAt   DateTime @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  payloadHash    String?  @map("payload_hash") @db.VarChar(64)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalSystem, entityType, externalId])
  @@unique([organizationId, entityType, entityId, externalSystem])
  @@index([organizationId, entityType, entityId])
  @@map("int_external_id_mappings")
}
