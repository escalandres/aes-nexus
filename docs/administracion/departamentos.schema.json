{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/administracion/departamentos.schema.json",
  "title": "Administración - Departamentos",
  "description": "Esquema JSON de campos obligatorios, tipos de datos y validaciones para la entidad Departamentos (/api/v1/admin/departments).",
  "$defs": {
    "CreateDepartmentDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "leader",
        "subsidiaryIds"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "leader": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "costCenter": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "subsidiaryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "UpdateDepartmentDTO": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "leader": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "costCenter": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "subsidiaryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "active": {
          "type": "boolean"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "BulkLinkDepartmentsDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subsidiaryId",
        "departmentIds",
        "mode"
      ],
      "properties": {
        "subsidiaryId": {
          "type": "string",
          "maxLength": 64
        },
        "departmentIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "link",
            "unlink"
          ]
        }
      }
    },
    "DepartmentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "leader",
        "subsidiaryIds",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "leader": {
          "type": "string"
        },
        "costCenter": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "subsidiaryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
