{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/administracion/subsidiarias.schema.json",
  "title": "Administración - Subsidiarias",
  "description": "Esquema JSON de campos obligatorios, tipos de datos y validaciones para la entidad Subsidiarias (/api/v1/admin/subsidiaries).",
  "$defs": {
    "SubsidiaryCurrency": {
      "type": "string",
      "enum": [
        "MXN",
        "USD",
        "EUR",
        "VES",
        "COP",
        "CLP",
        "PEN"
      ],
      "default": "MXN"
    },
    "CreateSubsidiaryDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "legalName",
        "taxId"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "legalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "taxId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "default": "México"
        },
        "currency": {
          "$ref": "#/$defs/SubsidiaryCurrency"
        },
        "legalRep": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "fiscalAddress": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "isHolding": {
          "type": "boolean",
          "default": false
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "linkedDepartmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "linkedLocationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "UpdateSubsidiaryDTO": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "legalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "taxId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "currency": {
          "$ref": "#/$defs/SubsidiaryCurrency"
        },
        "legalRep": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "fiscalAddress": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "isHolding": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "linkedDepartmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "linkedLocationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "SubsidiaryRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "legalName",
        "taxId",
        "country",
        "currency",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "legalName": {
          "type": "string"
        },
        "taxId": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "currency": {
          "$ref": "#/$defs/SubsidiaryCurrency"
        },
        "legalRep": {
          "type": [
            "string",
            "null"
          ]
        },
        "fiscalAddress": {
          "type": [
            "string",
            "null"
          ]
        },
        "isHolding": {
          "type": "boolean",
          "default": false
        },
        "active": {
          "type": "boolean"
        },
        "linkedDepartmentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "linkedLocationIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
