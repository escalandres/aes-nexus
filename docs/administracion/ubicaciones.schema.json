{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/administracion/ubicaciones.schema.json",
  "title": "Administración - Ubicaciones Físicas",
  "description": "Esquema JSON de campos obligatorios, tipos de datos y validaciones para la entidad Ubicaciones Físicas (/api/v1/admin/locations).",
  "$defs": {
    "LocationType": {
      "type": "string",
      "enum": [
        "Oficina corporativa",
        "Sucursal",
        "Almacén / Bodega",
        "Taller / Operación",
        "Punto de venta"
      ],
      "default": "Sucursal"
    },
    "CreateLocationDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "address",
        "city"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "type": {
          "$ref": "#/$defs/LocationType"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "default": "México"
        },
        "manager": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "subsidiaryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "UpdateLocationDTO": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "type": {
          "$ref": "#/$defs/LocationType"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "manager": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "subsidiaryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "active": {
          "type": "boolean"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "BulkLinkLocationsDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subsidiaryId",
        "locationIds",
        "mode"
      ],
      "properties": {
        "subsidiaryId": {
          "type": "string",
          "maxLength": 64
        },
        "locationIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "uniqueItems": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "link",
            "unlink"
          ]
        }
      }
    },
    "PhysicalLocationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "type",
        "address",
        "city",
        "state",
        "country",
        "subsidiaryIds",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/LocationType"
        },
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "manager": {
          "type": [
            "string",
            "null"
          ]
        },
        "subsidiaryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active": {
          "type": "boolean"
        },
        "linkedWarehouseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
