{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/backend/auth-y-tenancy.schema.json",
  "title": "Backend - Autenticación, Membresías y Contexto Tenant",
  "description": "Esquema JSON para sesiones de usuario OIDC, organizaciones, invitaciones y contexto efectivo RBAC.",
  "$defs": {
    "OrganizationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "name", "status", "reportingCurrency"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "reportingCurrency": { "type": "string", "minLength": 3, "maxLength": 8 }
      }
    },
    "AuthMeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "email",
        "name",
        "avatarInitials",
        "mfaVerified",
        "activeOrganizationId",
        "organizations",
        "activeRoleIds",
        "effectiveSectionPermissions",
        "effectiveCapabilities"
      ],
      "properties": {
        "userId": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string", "minLength": 1 },
        "avatarInitials": { "type": "string", "minLength": 1, "maxLength": 4 },
        "mfaVerified": { "type": "boolean" },
        "activeOrganizationId": { "type": "string", "format": "uuid" },
        "organizations": {
          "type": "array",
          "items": { "$ref": "#/$defs/OrganizationSummary" }
        },
        "activeRoleIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "effectiveSectionPermissions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["none", "view", "create", "edit", "full"]
            }
          }
        },
        "effectiveCapabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CreateInvitationDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "roleIds"],
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 180 },
        "roleIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "expiresInHours": { "type": "integer", "minimum": 1, "maximum": 336, "default": 72 }
      }
    }
  }
}
