{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/backend/contrato-api-global.schema.json",
  "title": "Backend - Contrato Global API REST",
  "description": "Esquema JSON estándar para paginación, parámetros de consulta y errores RFC 7807 ProblemDetails.",
  "$defs": {
    "PaginationQuery": {
      "type": "object",
      "properties": {
        "page": { "type": "integer", "minimum": 1, "default": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200, "default": 25 },
        "sortBy": { "type": "string", "maxLength": 64 },
        "sortDir": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
        "search": { "type": "string", "maxLength": 160 },
        "externalSource": { "type": "string", "maxLength": 80 },
        "externalId": { "type": "string", "maxLength": 120 },
        "includeDeleted": { "type": "boolean", "default": false }
      }
    },
    "PaginationMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "pageSize", "totalItems", "totalPages", "hasNext", "hasPrev", "requestId"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
        "totalItems": { "type": "integer", "minimum": 0 },
        "totalPages": { "type": "integer", "minimum": 0 },
        "hasNext": { "type": "boolean" },
        "hasPrev": { "type": "boolean" },
        "requestId": { "type": "string", "minLength": 1 }
      }
    },
    "DomainErrorCode": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "UNAUTHORIZED",
        "TENANT_MISMATCH",
        "RBAC_FORBIDDEN",
        "RESOURCE_NOT_FOUND",
        "DUPLICATE_FOLIO",
        "DUPLICATE_EXTERNAL_ID",
        "INVALID_STATE_TRANSITION",
        "INSUFFICIENT_STOCK",
        "INSUFFICIENT_FUNDS",
        "EXTERNAL_SOURCE_REQUIRED",
        "IDEMPOTENCY_CONFLICT",
        "RATE_LIMIT_EXCEEDED",
        "INTERNAL_ERROR"
      ]
    },
    "ProblemDetails": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "title", "status", "detail", "errorCode", "traceId"],
      "properties": {
        "type": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "detail": { "type": "string" },
        "instance": { "type": "string" },
        "errorCode": { "$ref": "#/$defs/DomainErrorCode" },
        "traceId": { "type": "string", "minLength": 1 },
        "errors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
