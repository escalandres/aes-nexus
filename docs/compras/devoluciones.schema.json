{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/compras/devoluciones.schema.json",
  "title": "Compras - Devoluciones a Proveedor (RTV)",
  "description": "Esquema JSON de campos obligatorios, tipos de datos y validaciones para Devoluciones a Proveedor (/api/v1/purchases/returns).",
  "$defs": {
    "ReturnReason": {
      "type": "string",
      "enum": [
        "Defecto de fábrica",
        "Daño en tránsito",
        "Error en surtido",
        "No cumple especificaciones",
        "Excedente / cambio comercial",
        "Garantía"
      ]
    },
    "SupplierReturnResolution": {
      "type": "string",
      "enum": [
        "Nota de crédito (CxP)",
        "Reposición de mercancía",
        "Reembolso proveedor"
      ],
      "default": "Nota de crédito (CxP)"
    },
    "SupplierReturnStatus": {
      "type": "string",
      "enum": [
        "Borrador",
        "Autorizada por proveedor",
        "Enviada a proveedor",
        "Acreditada / compensada",
        "Cancelada"
      ]
    },
    "ReturnItemCondition": {
      "type": "string",
      "enum": [
        "Sellado / intacto",
        "Empaque abierto",
        "Dañado / defectuoso"
      ]
    },
    "ReturnDisposition": {
      "type": "string",
      "enum": [
        "Reingreso a almacén",
        "Cuarentena / revisión",
        "Merma / baja definitiva",
        "Reposición con proveedor"
      ]
    },
    "ReturnApprovalStatus": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ]
    },
    "CurrencyCode": {
      "type": "string",
      "enum": [
        "MXN",
        "USD"
      ],
      "default": "MXN"
    },
    "TaxRate": {
      "type": "string",
      "enum": [
        "16%",
        "8%",
        "0%",
        "Exento"
      ],
      "default": "16%"
    },
    "ReturnLineItemInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "name",
        "quantity",
        "unitAmount",
        "taxRate",
        "unitOfMeasure",
        "condition",
        "disposition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitAmount": {
          "type": "number",
          "minimum": 0
        },
        "taxRate": {
          "$ref": "#/$defs/TaxRate"
        },
        "unitOfMeasure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "condition": {
          "$ref": "#/$defs/ReturnItemCondition"
        },
        "disposition": {
          "$ref": "#/$defs/ReturnDisposition"
        }
      }
    },
    "ReturnLineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sku",
        "name",
        "quantity",
        "unitAmount",
        "taxRate",
        "unitOfMeasure",
        "subtotal",
        "taxAmount",
        "total",
        "condition",
        "disposition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitAmount": {
          "type": "number",
          "minimum": 0
        },
        "taxRate": {
          "$ref": "#/$defs/TaxRate"
        },
        "unitOfMeasure": {
          "type": "string"
        },
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "taxAmount": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "condition": {
          "$ref": "#/$defs/ReturnItemCondition"
        },
        "disposition": {
          "$ref": "#/$defs/ReturnDisposition"
        }
      }
    },
    "ReturnWorkflowHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timestampIso",
        "toStatus",
        "actor",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "timestampIso": {
          "type": "string",
          "format": "date-time"
        },
        "fromStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "toStatus": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "created",
            "transition",
            "approval_requested",
            "approved",
            "approval_rejected"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CreateSupplierReturnDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplierCompany",
        "warehouseId",
        "reason",
        "resolution",
        "items"
      ],
      "properties": {
        "purchaseOrderId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "purchaseOrderFolio": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "default": "DIRECTA"
        },
        "billId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "billFolio": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "supplierCompany": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "supplierContact": {
          "type": "string",
          "maxLength": 150
        },
        "warehouseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reason": {
          "$ref": "#/$defs/ReturnReason"
        },
        "resolution": {
          "$ref": "#/$defs/SupplierReturnResolution"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "rmaSupplierCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ReturnLineItemInput"
          }
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "UpdateSupplierReturnDetailsDTO": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "rmaSupplierCode": {
          "type": "string",
          "maxLength": 80
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "TransitionSupplierReturnDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nextStatus"
      ],
      "properties": {
        "nextStatus": {
          "$ref": "#/$defs/SupplierReturnStatus"
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "rmaSupplierCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        }
      }
    },
    "RejectApprovalDTO": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "SupplierReturnRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "folio",
        "date",
        "purchaseOrderFolio",
        "supplierCompany",
        "supplierContact",
        "warehouseId",
        "warehouseName",
        "reason",
        "resolution",
        "status",
        "items",
        "subtotal",
        "taxTotal",
        "total",
        "currency",
        "createdBy",
        "updatedAtIso"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "folio": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "purchaseOrderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "purchaseOrderFolio": {
          "type": "string"
        },
        "billId": {
          "type": [
            "string",
            "null"
          ]
        },
        "billFolio": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplierCompany": {
          "type": "string"
        },
        "supplierContact": {
          "type": "string"
        },
        "warehouseId": {
          "type": "string"
        },
        "warehouseName": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ReturnReason"
        },
        "resolution": {
          "$ref": "#/$defs/SupplierReturnResolution"
        },
        "status": {
          "$ref": "#/$defs/SupplierReturnStatus"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ReturnLineItem"
          }
        },
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "taxTotal": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "inventoryApplied": {
          "type": "boolean"
        },
        "financeApplied": {
          "type": "boolean"
        },
        "creditNoteFolio": {
          "type": [
            "string",
            "null"
          ]
        },
        "rmaSupplierCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdBy": {
          "type": "string"
        },
        "updatedAtIso": {
          "type": "string",
          "format": "date-time"
        },
        "approvalStatus": {
          "$ref": "#/$defs/ReturnApprovalStatus"
        },
        "pendingTargetStatus": {
          "oneOf": [
            {
              "$ref": "#/$defs/SupplierReturnStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "approvalRequestedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvalRequestedAtIso": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "approvedAtIso": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "rejectionReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReturnWorkflowHistoryEntry"
          }
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
