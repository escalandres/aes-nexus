{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/compras/ordenes-compra.schema.json",
  "title": "Compras - Órdenes de Compra",
  "description": "Esquema JSON de campos obligatorios, tipos de datos y validaciones para Órdenes de Compra (/api/v1/purchases/orders).",
  "$defs": {
    "PurchaseOrderStatus": {
      "type": "string",
      "enum": [
        "Borrador",
        "Emitida",
        "Recepción parcial",
        "Recibida",
        "Cancelada"
      ],
      "default": "Emitida"
    },
    "CurrencyCode": {
      "type": "string",
      "enum": [
        "MXN",
        "USD"
      ],
      "default": "MXN"
    },
    "PurchaseTaxRate": {
      "type": "string",
      "enum": [
        "16%",
        "8%",
        "0%"
      ],
      "default": "16%"
    },
    "PurchaseOrderItemInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "name",
        "quantity",
        "unitCost"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitCost": {
          "type": "number",
          "minimum": 0
        },
        "taxRate": {
          "$ref": "#/$defs/PurchaseTaxRate"
        }
      }
    },
    "PurchaseOrderItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sku",
        "name",
        "quantity",
        "receivedQty",
        "unitCost",
        "taxRate",
        "subtotal",
        "taxAmount",
        "total"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "receivedQty": {
          "type": "number",
          "minimum": 0
        },
        "unitCost": {
          "type": "number",
          "minimum": 0
        },
        "taxRate": {
          "$ref": "#/$defs/PurchaseTaxRate"
        },
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "taxAmount": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "CreatePurchaseOrderDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplierCompany",
        "warehouseId",
        "items"
      ],
      "properties": {
        "supplierCompany": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "supplierContact": {
          "type": "string",
          "maxLength": 150
        },
        "supplierEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "warehouseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expectedDeliveryDate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "status": {
          "type": "string",
          "enum": [
            "Borrador",
            "Emitida"
          ],
          "default": "Emitida"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PurchaseOrderItemInput"
          }
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "UpdatePurchaseOrderStatusDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Emitida",
            "Cancelada"
          ]
        }
      }
    },
    "PurchaseOrderRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "folio",
        "supplierCompany",
        "supplierContact",
        "supplierEmail",
        "date",
        "expectedDeliveryDate",
        "warehouseId",
        "warehouseName",
        "items",
        "subtotal",
        "taxTotal",
        "total",
        "currency",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "folio": {
          "type": "string"
        },
        "supplierCompany": {
          "type": "string"
        },
        "supplierContact": {
          "type": "string"
        },
        "supplierEmail": {
          "type": "string",
          "format": "email"
        },
        "date": {
          "type": "string"
        },
        "expectedDeliveryDate": {
          "type": "string"
        },
        "warehouseId": {
          "type": "string"
        },
        "warehouseName": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PurchaseOrderItem"
          }
        },
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "taxTotal": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "status": {
          "$ref": "#/$defs/PurchaseOrderStatus"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
