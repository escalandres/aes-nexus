{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/configuracion/plan-facturacion.schema.json",
  "title": "Configuración - Plan y Facturación",
  "description": "Esquema JSON de suscripción SaaS, complementos, facturas CFDI de servicio y operaciones de reinicio de workspace.",
  "$defs": {
    "PlanTier": {
      "type": "string",
      "enum": ["Growth", "Enterprise", "Corporate"]
    },
    "PlanAddonsState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraWarehouses", "speiH2H", "auditArchive"],
      "properties": {
        "extraWarehouses": { "type": "boolean" },
        "speiH2H": { "type": "boolean" },
        "auditArchive": { "type": "boolean" }
      }
    },
    "PlanBillingInvoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "folio",
        "dateIso",
        "periodLabel",
        "concept",
        "paymentMethod",
        "subtotalMxn",
        "taxMxn",
        "amountMxn",
        "status",
        "cfdiUuid"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "folio": { "type": "string", "pattern": "^SUB-\\d{4}-\\d{2,4}$" },
        "dateIso": { "type": "string", "format": "date-time" },
        "periodLabel": { "type": "string", "minLength": 1 },
        "concept": { "type": "string", "minLength": 1 },
        "paymentMethod": { "type": "string", "minLength": 1 },
        "subtotalMxn": { "type": "number", "minimum": 0 },
        "taxMxn": { "type": "number", "minimum": 0 },
        "amountMxn": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["paid", "pending"] },
        "cfdiUuid": { "type": "string", "pattern": "^[A-Fa-f0-9-]{36}$" }
      }
    },
    "PlanSubscriptionSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "billingCycle",
        "autoRenew",
        "paymentBrand",
        "paymentLast4",
        "paymentExpiry",
        "paymentHolder",
        "billingEmail",
        "nextBillingIso",
        "storageUsedGb",
        "addons",
        "billingInvoices"
      ],
      "properties": {
        "tier": { "$ref": "#/$defs/PlanTier" },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual"] },
        "autoRenew": { "type": "boolean" },
        "paymentBrand": { "type": "string", "enum": ["VISA", "Mastercard", "AMEX", "SPEI"] },
        "paymentLast4": { "type": "string", "pattern": "^\\d{4}$" },
        "paymentExpiry": { "type": "string", "pattern": "^\\d{2}/\\d{4}$" },
        "paymentHolder": { "type": "string", "minLength": 1, "maxLength": 160 },
        "billingEmail": { "type": "string", "format": "email", "maxLength": 180 },
        "nextBillingIso": { "type": "string", "format": "date-time" },
        "storageUsedGb": { "type": "number", "minimum": 0 },
        "addons": { "$ref": "#/$defs/PlanAddonsState" },
        "billingInvoices": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlanBillingInvoice" }
        }
      }
    },
    "WorkspaceResetDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmationPhrase", "reason"],
      "properties": {
        "confirmationPhrase": { "type": "string", "minLength": 4, "maxLength": 64 },
        "reason": { "type": "string", "minLength": 5, "maxLength": 300 }
      }
    }
  }
}
