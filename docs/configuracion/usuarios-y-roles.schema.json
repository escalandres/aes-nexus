{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/configuracion/usuarios-y-roles.schema.json",
  "title": "Configuración - Usuarios y Roles RBAC",
  "description": "Esquema JSON de usuarios del espacio de trabajo y perfiles de roles granulares por módulo/sección.",
  "$defs": {
    "SectionAccessLevel": {
      "type": "string",
      "enum": [
        "none",
        "view",
        "create",
        "edit",
        "full"
      ]
    },
    "RoleCapabilityId": {
      "type": "string",
      "enum": [
        "sysConfig",
        "manageUsers",
        "approvePurchases",
        "fullReports",
        "inventoryControl",
        "adjustThresholds",
        "receiveGoods",
        "stockLedger",
        "createQuotes",
        "issueOrders",
        "crmClients",
        "pipelineReports",
        "manageReceivables",
        "schedulePayments",
        "balanceReports",
        "expenseControl"
      ]
    },
    "RoleSectionPermissions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/SectionAccessLevel"
        }
      }
    },
    "RoleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoleCapabilityId"
          },
          "uniqueItems": true
        },
        "sectionPermissions": {
          "$ref": "#/$defs/RoleSectionPermissions"
        },
        "builtInKey": {
          "type": "string",
          "enum": [
            "admin",
            "ops",
            "sales",
            "fin"
          ]
        },
        "forApiIntegration": {
          "type": "boolean",
          "default": false
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    },
    "UpsertRoleDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "sectionPermissions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "sectionPermissions": {
          "$ref": "#/$defs/RoleSectionPermissions"
        },
        "forApiIntegration": {
          "type": "boolean",
          "default": false
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "WorkspaceUserRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "email",
        "role",
        "status",
        "lastLogin",
        "avatarInitials"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "suspended"
          ],
          "default": "active"
        },
        "lastLogin": {
          "type": "string",
          "maxLength": 120
        },
        "avatarInitials": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    },
    "CreateWorkspaceUserDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "email",
        "roles"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 180
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "suspended"
          ],
          "default": "active"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    }
  }
}
