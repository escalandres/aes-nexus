{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/gastos/gastos-recurrentes.schema.json",
  "title": "Gastos - Gastos Recurrentes",
  "description": "Esquema JSON de plantillas de gastos recurrentes (/api/v1/expenses/recurring).",
  "$defs": {
    "ExpenseRecurrenceFrequency": {
      "type": "string",
      "enum": [
        "Mensual",
        "Quincenal",
        "Anual"
      ],
      "default": "Mensual"
    },
    "CreateRecurringExpenseDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "nature",
        "category",
        "beneficiary",
        "amount",
        "bankAccountId",
        "departmentName",
        "frequency",
        "nextRunDate"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "nature": {
          "type": "string",
          "enum": [
            "Administrativo",
            "Operativo",
            "Financiero",
            "Costo de venta",
            "Impuestos"
          ]
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "costBehavior": {
          "type": "string",
          "enum": [
            "Fijo",
            "Variable"
          ],
          "default": "Fijo"
        },
        "beneficiary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hasTax": {
          "type": "boolean",
          "default": true
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 80,
          "default": "Transferencia SPEI"
        },
        "bankAccountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "departmentId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "departmentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "locationId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "accountCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "frequency": {
          "$ref": "#/$defs/ExpenseRecurrenceFrequency"
        },
        "nextRunDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "GenerateBatchDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateIds"
      ],
      "properties": {
        "templateIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "RecurringExpenseTemplateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "nature",
        "category",
        "costBehavior",
        "beneficiary",
        "description",
        "amount",
        "hasTax",
        "paymentMethod",
        "bankAccountId",
        "bankAccountName",
        "departmentName",
        "frequency",
        "nextRunDate",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 150
        },
        "nature": {
          "type": "string",
          "enum": [
            "Administrativo",
            "Operativo",
            "Financiero",
            "Costo de venta",
            "Impuestos"
          ]
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "costBehavior": {
          "type": "string",
          "enum": [
            "Fijo",
            "Variable"
          ]
        },
        "beneficiary": {
          "type": "string",
          "maxLength": 180
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hasTax": {
          "type": "boolean"
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 80
        },
        "bankAccountId": {
          "type": "string",
          "maxLength": 64
        },
        "bankAccountName": {
          "type": "string",
          "maxLength": 120
        },
        "departmentId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "departmentName": {
          "type": "string",
          "maxLength": 120
        },
        "costCenter": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "locationId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "locationName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "accountCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 16
        },
        "accountName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 180
        },
        "frequency": {
          "$ref": "#/$defs/ExpenseRecurrenceFrequency"
        },
        "nextRunDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "lastGeneratedDate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
