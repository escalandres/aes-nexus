{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/operaciones/almacenes.schema.json",
  "title": "Operaciones - Almacenes",
  "description": "Esquema JSON de campos obligatorios, tipos de datos y validaciones para Almacenes (/api/v1/operations/warehouses).",
  "$defs": {
    "CreateWarehouseDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "city",
        "state",
        "address"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "address": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255
        },
        "capacityPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 0
        },
        "isDefault": {
          "type": "boolean",
          "default": false
        },
        "active": {
          "type": "boolean",
          "default": true
        },
        "locationId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "locationType": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80,
          "default": "Almacén / Bodega"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "UpdateWarehouseDTO": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "address": {
          "type": "string",
          "minLength": 4,
          "maxLength": 255
        },
        "capacityPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "isDefault": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "locationType": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "WarehouseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "city",
        "state",
        "address",
        "capacityPercentage",
        "isDefault",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "capacityPercentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "isDefault": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "locationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "locationType": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
