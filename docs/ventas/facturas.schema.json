{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/ventas/facturas.schema.json",
  "title": "Ventas - Facturas de Venta",
  "description": "Esquema JSON de campos obligatorios, tipos de datos y validaciones para Facturas de Venta (/api/v1/sales/invoices).",
  "$defs": {
    "InvoiceStatus": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Pagada",
        "Parcial",
        "Vencida"
      ],
      "default": "Pendiente"
    },
    "BillingMode": {
      "type": "string",
      "enum": [
        "full_remaining",
        "advance_50",
        "custom_pct"
      ],
      "default": "full_remaining"
    },
    "PaymentTerms": {
      "type": "string",
      "enum": [
        "Contado",
        "Crédito 15 días",
        "Crédito 30 días",
        "Crédito 60 días"
      ],
      "default": "Contado"
    },
    "CurrencyCode": {
      "type": "string",
      "enum": [
        "MXN",
        "USD"
      ],
      "default": "MXN"
    },
    "TaxRate": {
      "type": "string",
      "enum": [
        "16%",
        "8%",
        "0%",
        "Exento"
      ],
      "default": "16%"
    },
    "SalesLineItemInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "name",
        "type",
        "quantity",
        "unitPrice",
        "taxRate",
        "unitOfMeasure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "type": {
          "type": "string",
          "enum": [
            "product",
            "service"
          ]
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0
        },
        "taxRate": {
          "$ref": "#/$defs/TaxRate"
        },
        "unitOfMeasure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      }
    },
    "SalesLineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sku",
        "name",
        "type",
        "quantity",
        "unitPrice",
        "taxRate",
        "unitOfMeasure",
        "subtotal",
        "taxAmount",
        "total"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sku": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "product",
            "service"
          ]
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0
        },
        "taxRate": {
          "$ref": "#/$defs/TaxRate"
        },
        "unitOfMeasure": {
          "type": "string"
        },
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "taxAmount": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "CreateSalesInvoiceDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMode"
      ],
      "properties": {
        "sourceMode": {
          "type": "string",
          "enum": [
            "order",
            "direct"
          ]
        },
        "orderId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "orderFolio": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "billingMode": {
          "$ref": "#/$defs/BillingMode"
        },
        "customPct": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        },
        "clientCompany": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "clientName": {
          "type": "string",
          "maxLength": 150
        },
        "clientRfc": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 24
        },
        "paymentTerms": {
          "$ref": "#/$defs/PaymentTerms"
        },
        "paymentMethod": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "cfdiUse": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SalesLineItemInput"
          }
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceMode": {
                "const": "order"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "orderId"
                ]
              },
              {
                "required": [
                  "orderFolio"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sourceMode": {
                "const": "direct"
              }
            }
          },
          "then": {
            "required": [
              "clientCompany",
              "items"
            ],
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "SalesInvoiceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "folio",
        "orderFolio",
        "clientCompany",
        "clientName",
        "issueDate",
        "dueDate",
        "subtotal",
        "tax",
        "total",
        "paidAmount",
        "balance",
        "status",
        "currency"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "folio": {
          "type": "string"
        },
        "orderId": {
          "type": [
            "string",
            "null"
          ]
        },
        "orderFolio": {
          "type": "string"
        },
        "clientCompany": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "clientRfc": {
          "type": [
            "string",
            "null"
          ]
        },
        "issueDate": {
          "type": "string"
        },
        "dueDate": {
          "type": "string"
        },
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "tax": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "paidAmount": {
          "type": "number",
          "minimum": 0
        },
        "balance": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/InvoiceStatus"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "paymentMethod": {
          "type": [
            "string",
            "null"
          ]
        },
        "paymentTerms": {
          "type": [
            "string",
            "null"
          ]
        },
        "cfdiUse": {
          "type": [
            "string",
            "null"
          ]
        },
        "billingPercentage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SalesLineItem"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
