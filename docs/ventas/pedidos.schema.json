{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes-nexus.local/schemas/ventas/pedidos.schema.json",
  "title": "Ventas - Pedidos de Venta",
  "description": "Esquema JSON de campos obligatorios, tipos de datos y validaciones para Pedidos de Venta (/api/v1/sales/orders).",
  "$defs": {
    "OrderStatus": {
      "type": "string",
      "enum": [
        "Confirmado",
        "En preparación",
        "Enviado",
        "Entregado",
        "Cancelado"
      ],
      "default": "Confirmado"
    },
    "CurrencyCode": {
      "type": "string",
      "enum": [
        "MXN",
        "USD"
      ],
      "default": "MXN"
    },
    "TaxRate": {
      "type": "string",
      "enum": [
        "16%",
        "8%",
        "0%",
        "Exento"
      ],
      "default": "16%"
    },
    "SalesLineItemInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "name",
        "type",
        "quantity",
        "unitPrice",
        "taxRate",
        "unitOfMeasure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "type": {
          "type": "string",
          "enum": [
            "product",
            "service"
          ]
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0
        },
        "taxRate": {
          "$ref": "#/$defs/TaxRate"
        },
        "unitOfMeasure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      }
    },
    "SalesLineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sku",
        "name",
        "type",
        "quantity",
        "unitPrice",
        "taxRate",
        "unitOfMeasure",
        "subtotal",
        "taxAmount",
        "total"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sku": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "product",
            "service"
          ]
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0
        },
        "taxRate": {
          "$ref": "#/$defs/TaxRate"
        },
        "unitOfMeasure": {
          "type": "string"
        },
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "taxAmount": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "CreateOrderDTO": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "clientCompany",
        "clientName",
        "items"
      ],
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "clientCompany": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "quoteId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "quoteFolio": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "deliveryDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "default": 7
        },
        "deliveryDate": {
          "type": "string",
          "maxLength": 40
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "status": {
          "$ref": "#/$defs/OrderStatus"
        },
        "shippingAddress": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SalesLineItemInput"
          }
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "UpdateOrderDTO": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "deliveryDate": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "$ref": "#/$defs/OrderStatus"
        },
        "shippingAddress": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SalesLineItemInput"
          }
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        }
      }
    },
    "SalesOrderRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "folio",
        "clientId",
        "clientName",
        "clientCompany",
        "date",
        "deliveryDate",
        "items",
        "subtotal",
        "taxTotal",
        "total",
        "currency",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "folio": {
          "type": "string"
        },
        "quoteId": {
          "type": [
            "string",
            "null"
          ]
        },
        "quoteFolio": {
          "type": [
            "string",
            "null"
          ]
        },
        "clientId": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "clientCompany": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "deliveryDate": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SalesLineItem"
          }
        },
        "subtotal": {
          "type": "number",
          "minimum": 0
        },
        "taxTotal": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "$ref": "#/$defs/CurrencyCode"
        },
        "status": {
          "$ref": "#/$defs/OrderStatus"
        },
        "shippingAddress": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "invoiceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invoiceFolios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "description": "ID externo del registro en un sistema integrado (opcional)."
        },
        "externalSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "description": "Clave del sistema externo de origen (opcional; requerida si se envía externalId)."
        },
        "externalSyncedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "Fecha y hora UTC de última sincronización externa."
        }
      }
    }
  }
}
